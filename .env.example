# Copy to .env and adjust. All settings map to ACKIOLOGS_* env vars (see app/config.py).

# Storage — pick one.
# Zero-config (default): local SQLite file, no external DB required.
ACKIOLOGS_DATABASE_URL=sqlite+aiosqlite:///./data/ackiologs.db
# Production scale: TimescaleDB (or plain Postgres). Matches docker-compose.timescale.yml.
# ACKIOLOGS_DATABASE_URL=postgresql+asyncpg://ackiologs:ackiologs@localhost:5432/ackiologs

# Optional: JWT signing key. Leave unset/commented and the app generates a random one
# on first run, persisted next to the database — fine for a single instance. Set this
# explicitly only if you're running more than one instance and need them to share a key.
# ACKIOLOGS_SECRET_KEY=

# Set to false only for trusted, network-isolated demo/dev environments.
ACKIOLOGS_AUTH_ENABLED=true

# 0 = keep history forever. >0 = auto-prune tag_values older than N days. Only
# seeds the initial value on first run — once changed on the dashboard's Settings
# page, the saved value there takes over (works the same on SQLite and Postgres).
ACKIOLOGS_RETENTION_DAYS=0

# Used only by docker-compose.timescale.yml.
POSTGRES_PASSWORD=ackiologs

# Docker only: which host interface/port to publish on and how many days of
# history to keep (0 = forever). scripts/install.sh sets these for you.
ACKIOLOGS_HOST_BIND=0.0.0.0
ACKIOLOGS_PORT=8000

# Referenced by connections.yaml if you use ${VAR} placeholders for secrets.
# OPCUA_PASSWORD=
# MQTT_PASSWORD=
